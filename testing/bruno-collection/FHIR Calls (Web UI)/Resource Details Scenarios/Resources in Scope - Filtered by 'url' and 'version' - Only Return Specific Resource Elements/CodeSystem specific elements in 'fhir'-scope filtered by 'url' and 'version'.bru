meta {
  name: CodeSystem specific elements in 'fhir'-scope filtered by 'url' and 'version'
  type: http
  seq: 1
}

get {
  url: {{base_url}}/:scope/CodeSystem?_elements=url,version,description&url=http://fhir.de/CodeSystem/bfarm/icd-10-gm&version=2025
  body: none
  auth: inherit
}

params:query {
  _elements: url,version,description
  url: http://fhir.de/CodeSystem/bfarm/icd-10-gm
  version: 2025
}

params:path {
  scope: fhir
}

settings {
  encodeUrl: true
  timeout: 0
}
