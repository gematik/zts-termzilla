meta {
  name: Expand All Concepts of CodeSystem (no paging)
  type: http
  seq: 5
}

post {
  url: {{base_url}}/:scope/ValueSet/$expand
  body: json
  auth: inherit
}

params:path {
  scope: fhir
}

body:json {
  {
    "resourceType": "Parameters",
    "parameter": [
      {
        "name": "valueSet",
        "resource": {
          "resourceType": "ValueSet",
          "compose": {
            "include": [
              {
                "system": "https://terminologien.bfarm.de/fhir/CodeSystem/icd10gm-para295",
                "version": "2025"
              }
            ]
          }
        }
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
