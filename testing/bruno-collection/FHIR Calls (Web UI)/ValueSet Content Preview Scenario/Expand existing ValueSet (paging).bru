meta {
  name: Expand existing ValueSet (paging)
  type: http
  seq: 2
}

post {
  url: {{base_url}}/:scope/ValueSet/$expand
  body: json
  auth: inherit
}

params:path {
  scope: fhir
}

body:json {
  {
    "resourceType": "Parameters",
    "parameter": [
      {
        "name": "offset",
        "valueInteger": 0
      },{
        "name": "count",
        "valueInteger": 20
      },
      {
        "name": "url",
        "valueUri": "https://terminologien.bfarm.de/fhir/ValueSet/icd10gm-terminale-codes"
      },
      {
        "name": "valueSetVersion",
        "valueString": "2025"
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
