meta {
  name: v3-participationtype-useSupplement
  type: http
  seq: 36
}

post {
  url: {{baseUrl}}/fhir/ValueSet/$expand
  body: json
  auth: inherit
}

headers {
  Content-Type: application/fhir+json
  Accept: application/fhir+json
}

body:json {
  {
    "resourceType": "Parameters",
    "parameter": [
      {
        "name": "valueSet",
        "resource": {
          "resourceType": "ValueSet",
          "url": "http://terminology.hl7.org/ValueSet/v3-ParticipationType",
          "version": "4.0.1",
          "name": "V3ParticipationType",
          "title": "V3 Participation Type",
          "status": "active",
          "experimental": false,
          "immutable": true,
          "compose": {
            "include": [
              {
                "system": "http://terminology.hl7.org/CodeSystem/v3-ParticipationType",
                "version": "7.0.0"
              }
            ]
          }
        }
      },
      {
        "name": "useSupplement",
        "valueCanonical": "http://fhir.de/CodeSystem/v3-participationtype-de-de|0.1.0"
      },
      {
        "name": "displayLanguage",
        "valueCode": "de-DE"
      },
      {
        "name": "includeDesignations",
        "valueBoolean": true
      },
      {
        "name": "excludeNested",
        "valueBoolean": true
      },
      {
        "name": "includeDefinition",
        "valueBoolean": true
      },
      {
        "name": "count",
        "valueInteger": 100
      }
    ]
  }
}

tests {
  test("v3-participationtype useSupplement expansion includes the German designation", function() {
    const valueSet = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(valueSet.resourceType).to.equal("ValueSet");
    const concept = valueSet.expansion.contains.find(item => item.system === "http://terminology.hl7.org/CodeSystem/v3-ParticipationType" && item.code === "VRF");
    expect(concept).to.not.equal(undefined);
    expect(concept.designation.some(item => item.language === "de-DE" && item.value === "Verifizierende Person")).to.equal(true);
  });
}
