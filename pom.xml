  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <java.version>25</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <maven.compiler.spec>full</maven.compiler.spec>

    <maven.build.timestamp.format>yyyy-MM-dd'T'HH:mm:ss'Z'</maven.build.timestamp.format>
    <maven.clean.plugin.version>3.5.0</maven.clean.plugin.version>
    <maven.compiler.plugin.version>3.16.0</maven.compiler.plugin.version>
    <maven.dependency.plugin.version>3.9.0</maven.dependency.plugin.version>
    <maven.jar.plugin.version>3.5.0</maven.jar.plugin.version>
    <maven.shade.plugin.version>3.6.1</maven.shade.plugin.version>
    <maven.failsafe.plugin.version>3.6.1</maven.failsafe.plugin.version>
    <maven.surefire.version>3.6.1</maven.surefire.version>
    <maven.resources.plugin.version>3.5.0</maven.resources.plugin.version>
    <maven.assembly.plugin.version>3.8.0</maven.assembly.plugin.version>
    <maven.spotless.plugin.version>3.11.0</maven.spotless.plugin.version>

    <!-- Project Infrastructure Versions-->
    <lombok_version>1.18.48</lombok_version>

    <jakarta.servlet.version>6.1.0</jakarta.servlet.version>

    <!-- Testframeworks + Quality Test Versions -->
    <assertj.version>3.27.7</assertj.version>
    <mockito.version>5.24.0</mockito.version>
    <awaitability.version>4.3.0</awaitability.version>
    <webcompere.version>2.1.8</webcompere.version>

    <!-- Library Versions -->
    <semver4j.version>6.0.0</semver4j.version>
    <commons.collection.version>4.6.0</commons.collection.version>
    <commons.io.version>2.22.0</commons.io.version>
    <commons.compress.version>1.28.0</commons.compress.version>
    <hapifhir.version>8.12.1</hapifhir.version>
    <lucene.version>10.6.0</lucene.version>
    <jgrapht.version>1.5.3</jgrapht.version>
    <!-- ANTLR is a dependency of Snomed ECL -->
    <antlr.version>4.5.3</antlr.version>
    <opencsv.version>5.12.0</opencsv.version>
    <snomed.scg.version>4.0.0</snomed.scg.version>
    <snomed.ecl.version>4.0.0</snomed.ecl.version>
    <microprofile.config.version>3.1.3</microprofile.config.version>
    <smallrye.config.version>4.2.2</smallrye.config.version>
    <okhttp.version>5.5.1</okhttp.version>
    <fasterxml.jackson.version>2.22.4</fasterxml.jackson.version>
    <fasterxml.jackson.annotations.version>2.22</fasterxml.jackson.annotations.version>
    <!-- for relocated jackson dependencies (tools.jackson.x) -->
    <tools.jackson.version>3.2.4</tools.jackson.version>
    <logback.version>1.6.6</logback.version>
    <logstash.logback.version>9.0</logstash.logback.version>

    <!-- Code Coverage and QS Properties -->
    <jacoco.version>0.8.16</jacoco.version>
    <sonar.java.coveragePlugin>jacoco</sonar.java.coveragePlugin>
    <sonar.junit.reportPaths>target/surefire-reports/</sonar.junit.reportPaths>
    <sonar.coverage.jacoco.xmlReportPaths>
      ${maven.multiModuleProjectDirectory}/report-aggregate/target/site/jacoco-aggregate/jacoco.xml
    </sonar.coverage.jacoco.xmlReportPaths>
    <sonar.coverage.exclusions>testutils/src/main/java/**,**/module-info.java,**/package-info.java</sonar.coverage.exclusions>
    <sonar.language>java</sonar.language>
  </properties>

